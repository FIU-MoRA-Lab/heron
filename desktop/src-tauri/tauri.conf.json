{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heron Ground Station",
  "version": "0.1.0",
  "identifier": "org.heron.groundstation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Ground Station", "width": 1440, "height": 900, "minWidth": 1120, "minHeight": 720 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; worker-src 'self' blob:; object-src 'none'; frame-src 'none'",
      "capabilities": [{ "identifier": "main", "windows": ["main"], "permissions": ["core:default", "dialog:allow-open", "dialog:allow-save"] }]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../.bundle-resources/heron/": "backend/heron/",
      "../../backend/requirements.txt": "backend/requirements.txt",
      "../../FIU-basemap/": "FIU-basemap/"
    }
  }
}
